
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_centerVertical="true"/>

        </RelativeLayout>

        <!-- COVER DAN FOTO PROFIL -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgCover"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:src="@drawable/cover"
                android:scaleType="centerCrop"
                android:contentDescription="Cover photo"/>

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|center_horizontal"
                android:src="@drawable/profile"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:clipToOutline="true"
                android:contentDescription="Profile photo"/>

        </FrameLayout>

        <!-- NAMA -->
        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="William Siregar"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <!-- USERNAME -->
        <TextView
            android:id="@+id/txtUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@wiliisiregar
"
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <!-- BIO -->
        <TextView
            android:id="@+id/txtBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photography | Travel | Lifestyle"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:padding="12dp"/>

        <!-- CONTACT -->
        <TextView
            android:id="@+id/txtContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="wileesiregar@gmail.com"
            android:textSize="13sp"
            android:textColor="#777777"
            android:gravity="center"
            android:padding="3dp"/>

        <!-- COUNTRY -->
        <TextView
            android:id="@+id/txtCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Indonesia"
            android:textSize="13sp"
            android:textColor="#777777"
            android:gravity="center"
            android:padding="3dp"/>

        <!-- FOLLOW DAN SHARE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnFollow"
                android:layout_width="140dp"
                android:layout_height="45dp"
                android:text="Follow"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6C00E8"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="Share"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6C00E8"/>

        </LinearLayout>

        <!-- STATISTIK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtPosts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="205"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Posts"
                    android:textColor="#777777"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="45dp"
                android:background="#DDDDDD"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtFollowers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="205K"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Followers"
                    android:textColor="#777777"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="45dp"
                android:background="#DDDDDD"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtFollowing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="870"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Following"
                    android:textColor="#777777"/>

            </LinearLayout>

        </LinearLayout>

        <!-- EDIT PROFILE -->
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C00E8"/>

        <!-- FOLLOWERS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Followers"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:padding="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/profile"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:clipToOutline="true"
                android:contentDescription="Follower 1"/>

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="15dp"
                android:src="@drawable/post1"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:clipToOutline="true"
                android:contentDescription="Follower 2"/>

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="15dp"
                android:src="@drawable/post2"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:clipToOutline="true"
                android:contentDescription="Follower 3"/>

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="15dp"
                android:src="@drawable/post3"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:clipToOutline="true"
                android:contentDescription="Follower 4"/>

        </LinearLayout>

        <!-- JUDUL POSTINGAN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posts"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:padding="15dp"/>

        <!-- GALERI FOTO 3 KOLOM -->
        <GridLayout
            android:id="@+id/gridPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:padding="3dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:src="@drawable/post1"
                android:scaleType="centerCrop"
                android:contentDescription="Post 1"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:src="@drawable/post2"
                android:scaleType="centerCrop"
                android:contentDescription="Post 2"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:src="@drawable/post3"
                android:scaleType="centerCrop"
                android:contentDescription="Post 3"/>

        </GridLayout>

    </LinearLayout>

</ScrollView>
